# The question is whether temps are increasing year by year.
# The idea is to average max/min temperatures for each year
def years () :
    f = open ( temp_file, "r" )

    tag_list = []
    info_hash = {}

    # Idiot python idiom to end with 2026
    for y in range(2017, 2027) :
        #print ( y )
        tag = str(y)
        tag_list.append ( tag )
        info_hash[tag] = Info ( tag )

    while True :
        dinfo = get_day ( f )
        if dinfo == None :
            break
        (day,dd) = dinfo
        (min,max) = minmax ( dd )
        y = get_yr ( day )
        #print ( y )
        info_hash[y].insert ( min, max )

    for tag in tag_list :
        info_hash[tag].show ()

    f.close ()

