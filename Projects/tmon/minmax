#  temp-F

# Currently (8-19-2026) --
#  4414810  lines
def count_em () :

    f = open ( temp_file, "r" )

    n = 0
    for line in f:
        n += 1

    print ( n, " lines" )
    f.close ()

pushline = None

# readline returns an empty string at end of file
def get_line ( f ) :
    global pushline
    while True :
        if pushline != None :
            rv = pushline
            pushline = None
        else :
            rv = f.readline().strip()
        if rv == "" :
            return None
        if rv[0].isdigit () :
            break
    return rv

def push_line ( ll ) :
    global pushline
    pushline = ll

# Count all lines that are not rubbish
def count_valid () :
    f = open ( temp_file, "r" )

    n = 0
    while True :
        line = get_line ( f )
        if line == None :
            break
        n += 1

    print ( n, " valid lines"  )
    f.close ()

def get_day ( f ) :

    data = []

    line = get_line ( f )
    if line == None :
        return None
    w = line.split ()
    day = w[0]
    # print ( "Day: ", day )

    while True :
        line = get_line ( f )
        if line == None :
            break
        w = line.split ()
        if w[0] != day :
            break
        if "BAD" not in line :
            data.append ( line )

    push_line ( line )
    return (day, data)

def minmax ( data ) :
    tmin = 999.0
    tmax = 0.0
    for line in data :
        w = line.split ()
        tf = float ( w[6] ) / 10.0
        if tf < tmin :
            tmin = tf
        if tf > tmax :
            tmax = tf
    return ( tmin, tmax )

def show_day ( day, data ) :
        (min,max) = minmax ( data )
        print ( day, " ", len(data), " ", min, " ", max )
        # never happens
        # if len(data) < 1 :
        #   print ( day, " No data" )

def day_by_day () :
    f = open ( temp_file, "r" )

    while True :
        dinfo = get_day ( f )
        if dinfo == None :
            break
        (day,dd) = dinfo
        show_day ( day, dd )

    f.close ()

def get_md ( day ) :
    w = day.split ( "-" )
    return ( w[0], w[1] )

def get_yr ( day ) :
    w = day.split ( "-" )
    return w[2]

class Info () :
    def __init__ ( self, name ) :
        self.name = name
        self.max_sum = 0.0
        self.min_sum = 0.0
        self.num = 0;

    def insert ( self, min, max ) :
        self.min_sum += min
        self.max_sum += max
        self.num += 1

    def show ( self ) :
        tmin = self.min_sum / self.num
        tmax = self.max_sum / self.num
        #print ( self.name, " ", tmin, " ", tmax )
        print ( f'{self.name:>3} {tmin:8.2f} {tmax:8.2f}' )

def summAB () :
    f = open ( temp_file, "r" )
    tag_list = []
    info_hash = {}

    # Idiot python idiom to get 1..12
    for i in range(1, 13) :
        tag = str(i) + "A"
        tag_list.append ( tag )
        tag = str(i) + "B"
        tag_list.append ( tag )

    for t in tag_list :
        #print ( "Tag: ", t )
        inf = Info ( t )
        info_hash[t] = inf

    while True :
        dinfo = get_day ( f )
        if dinfo == None :
            break
        (day,dd) = dinfo
        (min,max) = minmax ( dd )
        #show_day ( day, dd )
        (m,d) = get_md ( day )
        if int(d) <= 14 :
            tag = m.lstrip('0') + "A"
        else :
            tag = m.lstrip('0') + "B"

        # print ( "I Tag: ", tag )
        info_hash[tag].insert ( min, max )

    for tag in tag_list :
        info_hash[tag].show ()

    f.close ()

